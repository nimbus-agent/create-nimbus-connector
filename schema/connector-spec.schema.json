          },
          "bindings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": {
            "default": false,
            "type": "boolean"
          },
          "default": {
            "type": "string"
          },
          "transform": {
            "type": "string",
            "enum": [
              "stripTrailingSlash",
              "trimTrailingSlashFn"
