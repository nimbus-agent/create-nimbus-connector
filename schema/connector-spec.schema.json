          },
          "prefix": {
            "type": "string"
          },
          "suffix": {
            "type": "string"
          },
          "auth": {
            "type": "string",
            "enum": [
              "bearer",
              "basic",
              "headers",
              "client-credentials"
            ]
          },
          "headerNames": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tokenLocal": {
            "type": "string",
            "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
          },
          "tokenUrl": {
            "type": "string",
            "format": "uri"
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "credentialsIn": {
            "type": "string",
            "enum": [
              "basic",
              "body"
            ]
          }
        },
        "required": [
          "vars",
          "local"
        ],
        "additionalProperties": false
      }
    },
    "fetchHelper": {
      "type": "object",
      "properties": {
        "local": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
