    "style": {
      "default": "rest-kit",
      "type": "string",
      "enum": [
        "rest-kit",
        "hand-rolled",
        "read-only-kit"
      ]
    },
    "handlerStyle": {
      "default": "concise",
      "type": "string",
      "enum": [
        "concise",
        "block"
      ]
