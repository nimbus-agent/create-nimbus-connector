              "additionalProperties": false
            }
          },
          "path": {
            "type": "string"
          },
          "query": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "arg": {
                  "type": "string",
                  "minLength": 1
                },
                "omitWhen": {
                  "type": "string",
                  "enum": [
                    "absent",
                    "empty"
                  ]
                }
              },
              "required": [
                "name",
                "arg"
              ],
              "additionalProperties": false
            }
          },
          "impl": {
            "default": "rest",
            "type": "string",
            "enum": [
              "rest",
              "get",
              "stub",
              "search"
            ]
          },
          "method": {
            "default": "GET",
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "effect": {
            "default": "read",
            "type": "string",
            "enum": [
              "read",
              "write",
              "delete"
            ]
          },
          "body": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "rows": {
            "type": "string",
            "minLength": 1
          },
          "maxLimit": {
            "default": 100,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "filter": {
            "type": "object",
            "properties": {
              "export": {
                "type": "string",
                "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
              },
              "fields": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "array",
                          "items": {
