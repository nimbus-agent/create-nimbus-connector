          "type": "boolean"
        },
        "jsonFallbackRaw": {
          "default": false,
          "type": "boolean"
        },
        "staticPathStyle": {
          "default": "quoted",
          "type": "string",
          "enum": [
            "quoted",
            "template"
          ]
        }
      },
      "required": [
        "local",
        "base"
      ],
      "additionalProperties": false
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
