                "local": {
                  "type": "string",
                  "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "int": {
                  "default": false,
                  "type": "boolean"
