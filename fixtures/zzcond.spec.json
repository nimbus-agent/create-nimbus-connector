{
  "name": "zzcond",
  "title": "Zzcond",
  "displayName": "ZZ Cond",
  "description": "Throwaway fixture proving the pathWhen conditional-endpoint guard end to end.",
  "serviceLabel": "ZZ Cond",
  "style": "hand-rolled",
  "network": ["api.zzcond.test"],
  "syncInterval": 300,
  "minNimbusVersion": "0.2.0",
  "env": [{ "vars": ["ZZCOND_TOKEN"], "local": "headers", "bindings": ["t"], "auth": "bearer" }],
  "fetchHelper": { "local": "zzGet", "base": "https://api.zzcond.test", "headers": "headers" },
  "tools": [
    {
      "name": "zzcond_item_get",
      "description": "Get one item, or the default item when no id is given.",
      "args": { "itemId": { "type": "string", "min": 1, "optional": true } },
      "path": "/v1/items/${arg.itemId|enc}",
      "pathWhen": [{ "absent": "itemId", "path": "/v1/items/default" }]
    }
  ]
}
